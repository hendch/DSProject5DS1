# Copy this file to `.env` and fill in your key. Never commit `.env`.
# Create a key at https://console.x.ai
XAI_API_KEY=

# Grok model used by the investigator. Model names change often:
# run `drift-agent llm check` to list the models your key can use.
XAI_MODEL=grok-4.3

# Only change this if xAI moves its endpoint.
XAI_BASE_URL=https://api.x.ai/v1
