# Copy to .env (never commit .env). Defaults match docker-compose.yml.
DATABASE_URL=postgresql://devops:devops@localhost:5432/agents
NEON_DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
CHROMA_HOST=localhost
CHROMA_PORT=8000
OLLAMA_MODEL=llama3.2:3b

# Which LLM the guardrail's judge uses (see agents/guardrail/llm_client.py)
LLM_PROVIDER=ollama                 # ollama | openai (any OpenAI-compatible API) | anthropic
LLM_API_KEY=                        # only for openai/anthropic. Put it in .env, never commit it
LLM_BASE_URL=https://api.groq.com/openai/v1   # openai only: Groq (free tier), OpenRouter, OpenAI...
LLM_MODEL=llama-3.1-8b-instant      # openai/anthropic only; Groq's hosted Llama 3.1 8B

# Guardrail agent
OPA_URL=http://localhost:8181
GUARDRAIL_LLM=on                    # off = skip the LLM reviewer (policy still decides)
GUARDRAIL_LLM_TIMEOUT=60
GUARDRAIL_APPROVAL_TTL_HOURS=4
GUARDRAIL_USE_SHARED=false          # true = read/write approvals on Neon
GUARDRAIL_CORS_ORIGINS=*
