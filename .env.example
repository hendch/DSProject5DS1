# One settings file for every agent. Copy to .env at the repo root; never commit .env.
# Defaults match docker-compose.yml.

# --- Shared infrastructure -------------------------------------------------------
# PostgreSQL holds everything: records, the event bus, the knowledge base, run state.
DATABASE_URL=postgresql://devops:devops@localhost:5432/agents
NEON_DATABASE_URL=                  # hosted Postgres for team integration (optional)
OPA_URL=http://localhost:8181

# --- Knowledge base (pgvector) -----------------------------------------------------
KNOWLEDGE_COLLECTION=devops_kb      # devops_kb_dev after: python -m agents.diagnostic_rca.seed_dev_kb
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # local, 384 dimensions (must match the database)

# --- LLM, shared by every agent --------------------------------------------------
# Any OpenAI-compatible endpoint: local Ollama, Hugging Face router, xAI, Groq...
#   Ollama:        LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
#   Hugging Face:  LLM_BASE_URL=https://router.huggingface.co/v1   LLM_API_KEY=hf_...
LLM_PROVIDER=ollama                 # ollama | openai (any OpenAI-compatible) | anthropic
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama                  # any text for Ollama; your real key for a hosted API
LLM_MODEL=llama3.1:8b
OLLAMA_MODEL=llama3.1:8b            # read by agents still on the ollama package (Phase 2 removes it)
LLM_RETRIES=2

# --- guardrail ---------------------------------------------------------------------
GUARDRAIL_LLM=on                    # off = skip the LLM judge (the policy still decides)
GUARDRAIL_LLM_TIMEOUT=60
GUARDRAIL_LLM_COOLDOWN=30
GUARDRAIL_APPROVAL_TTL_HOURS=4
GUARDRAIL_USE_SHARED=false          # true = approvals on NEON_DATABASE_URL
GUARDRAIL_CORS_ORIGINS=*

# --- diagnostic_rca ------------------------------------------------------------------
RETRIEVAL_MAX_DISTANCE=0.3          # cosine distance cutoff (calibrated on the dev seed)

# --- code_reviewer -------------------------------------------------------------------
LLM_BACKEND=openai                  # openai = the shared LLM settings above; claude-cli = Claude Code
# CLAUDE_CODE_OAUTH_TOKEN=          # only for LLM_BACKEND=claude-cli
# LLM_PRICE_IN_PER_MTOK=0           # optional, for the cost line in review reports
# LLM_PRICE_OUT_PER_MTOK=0

# --- drift_detection ----------------------------------------------------------------
# Still on its own variables until Phase 2 moves it to the shared LLM settings.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
# DRIFT_AGENT_HOME=                 # default: agents/drift_detection
